# Port the combined HTTP + WebSocket server listens on.
PORT=8080

# Directory containing the built client (index.html, assets/).
# Defaults to ../client/dist relative to the compiled server, which is correct
# for both local development and the Docker image.
# CLIENT_DIR=/app/client/dist

# Comma-separated list of allowed Origin headers for WebSocket upgrades.
# Leave unset to allow any origin (fine for local dev and single-origin deploys,
# since the client and server are served from the same host).
# ALLOWED_ORIGINS=https://doodl.fly.dev

# Set to "1" to log every inbound/outbound message. Very noisy.
# DEBUG_WIRE=0
