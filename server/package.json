{
  "name": "@doodl/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --enable-source-maps dist/index.js",
    "dev:tsc": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/smoke.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@doodl/shared": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3"
  }
}
